{
  "info": {
    "name": "IoT Gateway API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Contrato generico: el ESP32 se registra con sus componentes; los clientes leen sensores y envian comandos. Ejecutar en orden sobre un Gateway recien iniciado: newman run IoTGateway_Postman_Collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "apiKey",
      "value": "dev-key-local"
    },
    {
      "key": "deviceId",
      "value": "esp32-cam"
    }
  ],
  "item": [
    {
      "name": "1. Registro y telemetria (ESP32)",
      "item": [
        {
          "name": "Registrar dispositivo (ESP32-CAM)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/esp32/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "esp32",
                "register"
              ]
            },
            "description": "Device Discovery: el ESP32 informa quien es y que componentes tiene.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"deviceId\": \"{{deviceId}}\",\n  \"name\": \"ESP32-CAM Seguridad\",\n  \"components\": [\n    {\n      \"componentId\": \"distance_sensor\",\n      \"type\": \"Sensor\",\n      \"dataType\": \"Float\",\n      \"unit\": \"cm\"\n    },\n    {\n      \"componentId\": \"camera\",\n      \"type\": \"Actuator\",\n      \"dataType\": \"File\",\n      \"unit\": \"\",\n      \"actions\": [\n        \"CAPTURE\"\n      ]\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar con deviceId invalido -> 400",
